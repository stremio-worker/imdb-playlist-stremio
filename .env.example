# Read at build time, and from the environment in GitHub Actions.
# Copy this file into the repo and fill in real values, or define them under
# repository Settings > Secrets and variables > Actions.
#
# TMDB_API_KEY  -> Secret  (Settings > Secrets)
# everything else -> Variable (Settings > Variables)

# TMDB API key. https://www.themoviedb.org/settings/api
# Without it the build still runs, but descriptions stay in English.
TMDB_API_KEY=

# Comma-separated IMDb playlist ids. Playlist names are fetched from the API
# automatically, so there is no need to name them here.
# URL: https://www.imdb.com/list/ls051464199/  ->  id: ls051464199
IMDB_MOVIE_LISTS=ls051464199

# Series playlists, same comma-separated format.
IMDB_SERIES_LISTS=

# TMDB language parameter (titles, overviews and genres come back in it).
TMDB_LANGUAGE=tr

# Items per catalog page. Stremio expects at most 100.
CATALOG_PAGE_SIZE=100

# How many requests run at the same time.
FETCH_CONCURRENCY=8